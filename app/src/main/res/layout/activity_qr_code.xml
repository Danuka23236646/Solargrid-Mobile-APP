<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F8FAFC">

    <!-- Top AppBar Header -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarQrCode"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0052CC"
        app:title="Transaction QR Code"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Present this QR code to the station operator to verify and finalize transfer"
                android:textSize="14sp"
                android:textColor="#475569"
                android:textAlignment="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp" />

            <!-- QR Code Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="260dp"
                android:layout_height="260dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#0052CC"
                app:strokeWidth="1.5dp"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/ivQrCode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="QR Code Image" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Secure Human-Readable Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvQrBookingRef"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ref: #80438"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#0052CC" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒 Encrypted Dispatch Token"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#059669"
                            android:background="#D1FAE5"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E2E8F0"
                        android:layout_marginVertical="10dp" />

                    <TextView
                        android:id="@+id/tvQrMaskedNic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prosumer NIC: 2003****0245"
                        android:textSize="14sp"
                        android:textColor="#0F172A" />

                    <TextView
                        android:id="@+id/tvQrDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Volume: 50.0 kWh (SELL)"
                        android:textSize="14sp"
                        android:textColor="#475569"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseQr"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="CLOSE"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:backgroundTint="#0052CC" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
