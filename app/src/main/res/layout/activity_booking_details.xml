<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F8FAFC">

    <!-- Top AppBar Header -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDetails"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0052CC"
        app:title="Booking Details"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 12-Hour Lock Alert Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLockWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FEF2F2"
                app:strokeColor="#DC2626"
                app:strokeWidth="1dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️ "
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="12-Hour Lock Rule: Less than 12 hours remaining until transfer. Modifications and cancellations are now locked."
                        android:textSize="13sp"
                        android:textColor="#B91C1C"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvDetailsBookingId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Booking #101"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#0052CC" />

                    <TextView
                        android:id="@+id/tvDetailsProsumerNic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prosumer NIC: 992345678V"
                        android:textSize="14sp"
                        android:textColor="#475569"
                        android:layout_marginTop="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E2E8F0"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        android:id="@+id/tvDetailsStation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Microgrid Station: Colombo North"
                        android:textSize="15sp"
                        android:textColor="#0F172A" />

                    <TextView
                        android:id="@+id/tvDetailsScheduledTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scheduled Time: 2025-05-20 14:00"
                        android:textSize="15sp"
                        android:textColor="#0F172A"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvDetailsKwh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Energy Volume: 50.0 kWh"
                        android:textSize="15sp"
                        android:textColor="#0F172A"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvDetailsType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Type: SELL"
                        android:textSize="15sp"
                        android:textColor="#0F172A"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvDetailsStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status: CONFIRMED"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#059669"
                        android:layout_marginTop="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerateQrCode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="GENERATE TRANSACTION QR CODE"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:backgroundTint="#0052CC"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModifyBooking"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Modify"
                    android:textColor="#0052CC"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="#0052CC"
                    app:strokeWidth="1.5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelBooking"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Cancel"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    android:backgroundTint="#DC2626" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
