<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F8FAFC">

    <!-- Top AppBar Header -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarProfile"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0052CC"
        app:title="Prosumer Profile"
        app:titleTextColor="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/ic_profile"
                app:tint="#0052CC"
                android:contentDescription="Profile Icon" />

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Prosumer"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvProfileNic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NIC (Primary Key): 992345678V"
                android:textSize="14sp"
                android:textColor="#475569"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvProfileStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account Status: Active"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#059669"
                android:background="#D1FAE5"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

            <!-- Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp"
                android:layout_marginBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email: john@solar.org"
                        android:textSize="15sp"
                        android:textColor="#0F172A" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E2E8F0"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        android:id="@+id/tvProfileRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Role: PROSUMER"
                        android:textSize="15sp"
                        android:textColor="#0F172A" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Request Account Deactivation Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRequestDeactivation"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Request Account Deactivation"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:backgroundTint="#DC2626"
                android:layout_marginBottom="16dp" />

            <!-- Logout Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="LOGOUT"
                android:textColor="#0052CC"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#0052CC"
                app:strokeWidth="1.5dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
