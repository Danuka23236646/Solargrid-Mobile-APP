<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F8FAFC">

    <!-- Top AppBar Header -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarSummary"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0052CC"
        app:title="Reservation Summary"
        app:titleTextColor="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/ivSummaryStatusIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="8dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="#059669"
                android:contentDescription="Status Icon" />

            <TextView
                android:id="@+id/tvSummaryHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reservation Successful!"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#059669"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Summary of energy transfer transaction"
                android:textSize="13sp"
                android:textColor="#475569"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp"
                android:layout_marginBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvSummaryBookingId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Booking ID: #101"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#0052CC" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E2E8F0"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        android:id="@+id/tvSummaryNic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prosumer NIC: 992345678V"
                        android:textSize="15sp"
                        android:textColor="#0F172A" />

                    <TextView
                        android:id="@+id/tvSummaryStation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Station: Colombo Microgrid Hub"
                        android:textSize="15sp"
                        android:textColor="#0F172A"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvSummaryTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scheduled Time: 2025-05-20 14:00"
                        android:textSize="15sp"
                        android:textColor="#0F172A"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvSummaryKwh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Energy Volume: 50.0 kWh"
                        android:textSize="15sp"
                        android:textColor="#0F172A"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvSummaryType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transfer Type: SELL"
                        android:textSize="15sp"
                        android:textColor="#0F172A"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvSummaryStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status: CONFIRMED"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#059669"
                        android:layout_marginTop="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewQrCode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="SHOW QR CODE FOR DISPATCH"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:backgroundTint="#0052CC"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDoneSummary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="BACK TO DASHBOARD"
                android:textColor="#0052CC"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#0052CC"
                app:strokeWidth="1.5dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
