<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Smart Solar Microgrid"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartSolarMicrogrid"
        android:usesCleartextTraffic="true">

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="YOUR_GOOGLE_MAPS_API_KEY_HERE" />

        <!-- Login Activity (Launcher Entry Point) -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Register Activity -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />

        <!-- Prosumer Main Activity -->
        <activity
            android:name=".ui.prosumer.ProsumerMainActivity"
            android:exported="false" />

        <!-- Booking Activities -->
        <activity
            android:name=".ui.prosumer.booking.CreateBookingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.prosumer.booking.BookingSummaryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.prosumer.booking.BookingDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.prosumer.booking.QrCodeActivity"
            android:exported="false" />

        <!-- Operator Activities -->
        <activity
            android:name=".ui.operator.OperatorMainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.operator.QrScannerActivity"
            android:exported="false" />

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>
